  {
    "code": "HILO",
    "name": "HILO T-VAN",
    "environment": "UAT",
    "baseUrl": "https://uatapitctn.hilo.com.vn",
    "isActive": true,
    "priority": 20,
    "timeoutSeconds": 60,
    "authSchemeKey": "login-token",
    "_secretKeys": ["TaxCode", "UserName", "Password", "MNGui", "MNNhan", "CallbackBaseUrl", "CallbackSecret"],
    "_note": "Tai lieu khong ghi base URL Production va khong mo ta payload webhook. callbackMap ben duoi la gia dinh, phai confirm voi Hilo truoc khi len PROD.",
    "authConfig": {
      "loginPath": "/api/authentication/gettoken",
      "bodyTemplate": "{\"TaxCode\":\"{{ cred.TaxCode }}\",\"UserName\":\"{{ cred.UserName }}\",\"Password\":\"{{ cred.Password }}\"}",
      "format": "json",
      "tokenPath": "Data.accessToken",
      "successPath": "Code",
      "successValues": ["200"],
      "messagePath": "Information",
      "headerName": "Authorization",
      "headerFormat": "Bearer {{ msg.token }}",
      "ttlSeconds": 1800
    },
    "callbackMap": {
      "format": "json",
      "correlationPath": "Data.MTDTChieu",
      "codePath": "Data.Response[0].MLTDiep",
      "messagePath": "Data.Response[0].Message",
      "successValues": ["999", "202", "204"],
      "secretHeader": "X-Callback-Token",
      "secretRef": "CallbackSecret"
    },
    "headers": [
      {
        "name": "CallBackUrl",
        "valueTemplate": "{{ cred.CallbackBaseUrl }}/api/tvan/callbacks/HILO",
        "order": 1
      }
    ],
    "endpoints": [
      {
        "operationCode": "send-registration",
        "httpMethod": "POST",
        "pathTemplate": "/api/einvoicesolution/send",
        "contentType": "application/json",
        "args": { "PBan": "2.1.0", "MLTDiep": "100", "SLuong": "1" },
        "requestTransforms": [],
        "bodyTemplate": "{\"PBan\":\"{{ msg.PBan }}\",\"MNGui\":\"{{ cred.MNGui }}\",\"MNNhan\":\"{{ cred.MNNhan }}\",\"MLTDiep\":{{ msg.MLTDiep }},\"MTDiep\":\"{{ msg.MTDiep }}\",\"MST\":\"{{ msg.MST }}\",\"SLuong\":{{ msg.SLuong }},\"XmlData\":[{\"Xml\":{{ msg.Xml | json_string }}}]}",
        "responseMap": {
          "result": {
            "format": "json",
            "successPath": "Code",
            "successValues": ["200"],
            "messagePath": "Information",
            "referencePath": "Data.MTDiep"
          }
        }
      },
